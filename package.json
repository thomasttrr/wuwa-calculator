{
  "name": "wuwa-calculator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "theWuthering: a local-first Wuthering Waves damage calculator and build lab (fan-made, unofficial).",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.engine.json && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "data:fetch": "tsx scripts/data/fetch.ts",
    "data:build": "tsx scripts/data/normalise.ts && tsx scripts/data/crosscheck.ts && tsx scripts/data/build-effects.ts",
    "data:check": "tsx scripts/data/check.ts",
    "verify:screens": "tsx scripts/verify/screenshots.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/albert-sans": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "idb": "^8.0.4",
    "immer": "^11.2.10",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.8",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
